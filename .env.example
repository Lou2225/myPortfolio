# ============================================================================
# Portfolio Environment Variables Template (Copy to .env.local for local dev)
# ============================================================================
# Never commit .env.local or real API secrets to version control.

# ----------------------------------------------------------------------------
# 1. Transactional Email API (Resend — https://resend.com)
# ----------------------------------------------------------------------------
# Free tier: 3,000 emails/mo. Leave blank to fall back to DB inbox + mailto:.
RESEND_API_KEY=
# Verified sender domain address (e.g. "Lou Portfolio <hello@yourdomain.com>").
# Sandbox default "Portfolio CMS <onboarding@resend.dev>" can only email your own Resend account email.
RESEND_FROM_EMAIL=
# Destination inbox for public Contact Form alerts (defaults to CMS profile.contact.email if blank).
CONTACT_NOTIFICATION_EMAIL=

# ----------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Media Storage (https://supabase.com)
# ----------------------------------------------------------------------------
# Leave blank to run seamlessly against local /data/portfolio-db.json in dev.
# Required in Vercel production deployments.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=myPortfolio

# ----------------------------------------------------------------------------
# 3. Admin Authentication, Cryptography & Origin Canonicalization
# ----------------------------------------------------------------------------
# Required to sign into /admin (falls back only when overridden in Supabase credential store).
ADMIN_PASSWORD=
# Required HMAC-SHA256 signing & TOTP AES-256-GCM encryption secret (minimum 32 random chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Optional ?portal= stealth gate access key when Stealth Mode is active.
ADMIN_STEALTH_KEY=
# Canonical public origin for SEO, manifest, OpenGraph, and mobile QR pairing links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 4. Optional Live GitHub Stats Integration (/api/github — planned)
# ----------------------------------------------------------------------------
GITHUB_USERNAME=
# Optional personal access token (increases GitHub REST rate limit from 60 to 5,000 req/hr).
GITHUB_TOKEN=
